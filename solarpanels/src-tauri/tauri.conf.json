{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "solarpanels",
  "version": "0.1.0",
  "identifier": "com.tauri.app",
  "plugins": {
    "http" :{
      "enabled" : true
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "solarpanels",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
